// Modelo de datos de AppIglesia — fuente: specs.md §6.
// Dueño: B1. Cambios solo vía PR revisado por B1 y el dueño del modelo (AGENTS.md §3).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Rol {
  // Nacional (Ecclesia): sin iglesia asignada
  COORDINACION
  // Antes ADMIN; administrador de una iglesia
  ADMIN_IGLESIA
  PASTOR
  SECRETARIO
  TESORERO
  COORDINADOR
}

enum TipoIglesia {
  CATEDRAL
  BASILICA
  PARROQUIA
  TEMPLO
  CAPILLA
  SANTUARIO
}

// E2-08 (Nataly): tipos de objeto (RN-16). El dominio los agrupa en los cinco grupos del índice.
enum TipoObjeto {
  IMAGEN
  RETABLO
  PINTURA
  MURAL
  ORGANO
  PIANO
  ORFEBRERIA
  MOBILIARIO_LITURGICO
  DOCUMENTO
  OTRO
}

// Solo los VIGENTES cuentan en el índice; los demás se conservan (RN-11)
enum EstadoObjeto {
  VIGENTE
  PERDIDO
  PRESTADO
  BAJA
}

enum TipoEvento {
  RELIGIOSO
  ADMINISTRATIVO
}

enum CategoriaEvento {
  CULTO
  REUNION
  ACTIVIDAD
  OTRO
}

enum EstadoEvento {
  PROGRAMADO
  CANCELADO
  REALIZADO
}

enum ConceptoDonacion {
  DIEZMO
  OFRENDA
  PRIMICIA
  DONACION_ESPECIAL
  OTRO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  OTRO
}

enum PrioridadAnuncio {
  NORMAL
  IMPORTANTE
}

// ───────────── B1 · Usuarios y autenticación ─────────────

model Usuario {
  id                 String             @id @default(uuid())
  nombre             String
  email              String             @unique
  // Nulo mientras el usuario no configura su contraseña desde la invitación (B1-14)
  passwordHash       String?
  rol                Rol
  // Iglesia a la que pertenece el personal. Nulo solo para la Coordinación (alcance nacional).
  iglesiaId          String?
  // Restrict: una iglesia con personal no se borra (se cierra con `activa = false`)
  iglesia            Iglesia?           @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  diezmosCapturados  Diezmo[]           @relation("DiezmoCapturador")
  correccionesDiezmo DiezmoCorreccion[] @relation("DiezmoCorrector")
  // E3-05 (Genaro): quién registró cada misa celebrada y cada sustitución (RF-50)
  misasRegistradas   MisaCelebrada[]    @relation("MisaRegistrador")
  sustitucionesMisa  SustitucionMisa[]  @relation("SustitucionAutor")
  // E2-10 (Nataly): quién guardó cada versión de los criterios del índice
  criteriosIndice    CriteriosIndice[]
  activo             Boolean            @default(true)
  ultimoAcceso       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  refreshTokens          RefreshToken[]
  resetTokens            PasswordResetToken[]
  ministeriosCoordinados MinisterioCoordinador[]
  eventosCreados         Evento[]                @relation("EventoCreador")
  asistenciasRegistradas Asistencia[]            @relation("AsistenciaRegistrador")
  donacionesRegistradas  Donacion[]              @relation("DonacionRegistrador")
  donacionesActualizadas Donacion[]              @relation("DonacionActualizador")
  anuncios               Anuncio[]

  @@index([iglesiaId])
  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  tokenHash  String    @unique
  expiraEn   DateTime
  revocadoEn DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

// ───────────── B2 · Miembros y ministerios ─────────────

model Miembro {
  id              String    @id @default(uuid())
  nombre          String
  apellidos       String
  telefono        String?
  email           String?
  fechaIngreso    DateTime  @db.Date
  fechaNacimiento DateTime? @db.Date
  direccion       String?
  notas           String?
  activo          Boolean   @default(true)
  fechaBaja       DateTime? @db.Date
  motivoBaja      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  ministerios   MiembroMinisterio[]
  responsableDe EventoResponsable[]
  asistencias   Asistencia[]
  donaciones    Donacion[]

  @@index([apellidos, nombre])
  @@index([activo])
  @@index([iglesiaId, activo])
  @@map("miembros")
}

model Ministerio {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  coordinadores MinisterioCoordinador[]
  miembros      MiembroMinisterio[]
  eventos       Evento[]

  // E1-06: el nombre es único dentro de cada iglesia (antes, en todo el sistema)
  @@unique([iglesiaId, nombre])
  @@map("ministerios")
}

model MinisterioCoordinador {
  ministerioId String
  usuarioId    String

  ministerio Ministerio @relation(fields: [ministerioId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@id([ministerioId, usuarioId])
  @@index([usuarioId])
  @@map("ministerio_coordinadores")
}

model MiembroMinisterio {
  miembroId    String
  ministerioId String
  fechaUnion   DateTime  @default(now())
  fechaSalida  DateTime?
  activo       Boolean   @default(true)

  miembro    Miembro    @relation(fields: [miembroId], references: [id])
  ministerio Ministerio @relation(fields: [ministerioId], references: [id])

  @@id([miembroId, ministerioId])
  @@index([ministerioId])
  @@map("miembro_ministerios")
}

// ───────────── B3 · Eventos, asistencia y anuncios ─────────────

model Evento {
  id                String          @id @default(uuid())
  titulo            String
  descripcion       String?
  tipo              TipoEvento
  categoria         CategoriaEvento
  fechaInicio       DateTime
  fechaFin          DateTime?
  lugar             String
  estado            EstadoEvento    @default(PROGRAMADO)
  motivoCancelacion String?
  ministerioId      String?
  creadoPorId       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  ministerio   Ministerio?         @relation(fields: [ministerioId], references: [id])
  creadoPor    Usuario             @relation("EventoCreador", fields: [creadoPorId], references: [id])
  responsables EventoResponsable[]
  asistencias  Asistencia[]
  anuncios     Anuncio[]

  @@index([fechaInicio])
  @@index([ministerioId])
  @@index([iglesiaId, fechaInicio])
  @@map("eventos")
}

model EventoResponsable {
  eventoId  String
  miembroId String

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  miembro Miembro @relation(fields: [miembroId], references: [id])

  @@id([eventoId, miembroId])
  @@map("evento_responsables")
}

model Asistencia {
  id              String   @id @default(uuid())
  eventoId        String
  miembroId       String
  presente        Boolean
  registradoPorId String
  registradoEn    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evento        Evento  @relation(fields: [eventoId], references: [id])
  miembro       Miembro @relation(fields: [miembroId], references: [id])
  registradoPor Usuario @relation("AsistenciaRegistrador", fields: [registradoPorId], references: [id])

  @@unique([eventoId, miembroId])
  @@index([miembroId])
  @@map("asistencias")
}

model Anuncio {
  id               String           @id @default(uuid())
  titulo           String
  // Texto plano o markdown simple
  contenido        String
  prioridad        PrioridadAnuncio @default(NORMAL)
  fechaPublicacion DateTime
  fechaExpiracion  DateTime?
  eventoId         String?
  autorId          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  evento Evento? @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  autor  Usuario @relation(fields: [autorId], references: [id])

  @@index([fechaPublicacion])
  @@index([iglesiaId, fechaPublicacion])
  @@map("anuncios")
}

// ───────────── B4 · Donaciones ─────────────

model Donacion {
  id               String           @id @default(uuid())
  fecha            DateTime         @db.Date
  monto            Decimal          @db.Decimal(12, 2)
  concepto         ConceptoDonacion
  conceptoDetalle  String?
  metodo           MetodoPago
  // Nulo ⇔ donación anónima (specs.md §6, reglas de integridad)
  miembroId        String?
  anonima          Boolean          @default(false)
  referencia       String?
  notas            String?
  anulada          Boolean          @default(false)
  motivoAnulacion  String?
  anuladaEn        DateTime?
  registradoPorId  String
  actualizadoPorId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  miembro        Miembro? @relation(fields: [miembroId], references: [id])
  registradoPor  Usuario  @relation("DonacionRegistrador", fields: [registradoPorId], references: [id])
  actualizadoPor Usuario? @relation("DonacionActualizador", fields: [actualizadoPorId], references: [id])

  @@index([fecha])
  @@index([miembroId])
  @@index([iglesiaId, fecha])
  @@map("donaciones")
}

// ───────────── Ecclesia · Iglesias ─────────────

// Una fila por iglesia. Reemplaza a la fila única de ConfiguracionIglesia; la ficha completa
// (dirección, INEGI, contacto, patrimonio) la amplía el módulo de iglesias.
model Iglesia {
  id          String      @id @default(uuid())
  nombre      String
  tipo        TipoIglesia
  zonaHoraria String      @default("America/Mexico_City")
  // E1-06b: datos institucionales que antes vivían en ConfiguracionIglesia (fila única)
  moneda      String      @default("MXN")
  logoUrl     String?
  sitioWeb    String?
  // Una iglesia cerrada conserva su historia pero no aparece en consultas públicas
  activa      Boolean     @default(true)

  // E2-06 (Nataly): ubicación del catálogo del INEGI (RN-09 se valida en iglesias.service) y datos
  // de la ficha (RF-07). Opcionales mientras no se carguen el catálogo y los seeds (E2-05, E2-09).
  direccion        String?
  estadoClave      String?   @db.Char(2)
  municipioClave   String?   @db.Char(5)
  localidadClave   String?   @db.Char(9)
  capacidad        Int?
  anioConstruccion Int?
  telefono         String?
  correo           String?
  latitud          Decimal?  @db.Decimal(9, 6)
  longitud         Decimal?  @db.Decimal(9, 6)
  // Cierre sin borrar la historia (RF-11, RN-07)
  fechaCierre      DateTime? @db.Date
  motivoCierre     String?
  // Foto de la iglesia (2026-11-26, propuesta de Oscar): solo la URL, sin subir archivos. Las de
  // Wikimedia Commons piden autor y licencia junto a la foto (CC BY / CC BY-SA), por eso van aquí.
  fotoUrl          String?
  fotoAutor        String?
  fotoLicencia     String?
  fotoLicenciaUrl  String?
  fotoEnlace       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estado    Estado?    @relation(fields: [estadoClave], references: [clave], onDelete: Restrict)
  municipio Municipio? @relation(fields: [municipioClave], references: [clave], onDelete: Restrict)
  localidad Localidad? @relation(fields: [localidadClave], references: [clave], onDelete: Restrict)

  usuarios           Usuario[]
  misas              MisaCelebrada[]
  // E3-05 (Genaro): padres asociados y horario semanal de misas
  padres             PadreIglesia[]
  horariosMisa       HorarioMisa[]
  // E3-11 y E3-13 (Genaro): servicios y pláticas
  servicios          Servicio[]
  platicas           Platica[]
  diezmos            Diezmo[]
  tiposEspacio       TipoEspacio[]
  solicitudesEspacio SolicitudEspacio[]
  objetos            ObjetoPatrimonial[]
  // E1-06: gestión interna de cada iglesia
  miembros           Miembro[]
  ministerios        Ministerio[]
  eventos            Evento[]
  anuncios           Anuncio[]
  donaciones         Donacion[]
  horariosReunion    HorarioReunion[]

  @@index([estadoClave, activa])
  @@index([municipioClave])
  @@map("iglesias")
}

// ───────────── Ecclesia · Catálogo del INEGI (E2-05, Nataly) ─────────────
// Claves oficiales: estado (2 dígitos), estado + municipio (5) y estado + municipio + localidad (9).

model Estado {
  clave  String @id @db.Char(2)
  nombre String

  municipios Municipio[]
  iglesias   Iglesia[]

  @@map("estados")
}

model Municipio {
  clave       String @id @db.Char(5)
  estadoClave String @db.Char(2)
  nombre      String

  estado      Estado      @relation(fields: [estadoClave], references: [clave], onDelete: Restrict)
  localidades Localidad[]
  iglesias    Iglesia[]

  @@index([estadoClave])
  @@map("municipios")
}

model Localidad {
  clave          String @id @db.Char(9)
  municipioClave String @db.Char(5)
  nombre         String

  municipio Municipio @relation(fields: [municipioClave], references: [clave], onDelete: Restrict)
  iglesias  Iglesia[]

  @@index([municipioClave])
  @@map("localidades")
}

// ───────────── Ecclesia · Misas y diezmo ─────────────

// Padre que oficia misas (RF-40). E3-05: título y asociación a varias iglesias (RF-41, RN-28).
// Supuesto P-19: la Coordinación edita sus datos; cada iglesia solo lo asocia o desasocia.
model Padre {
  id        String   @id @default(uuid())
  nombre    String
  // «Pbro.», «Fr.», «Mons.»… El público ve solo título y nombre (P-19)
  titulo    String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  misas                   MisaCelebrada[]   @relation("MisaPadreReal")
  iglesias                PadreIglesia[]
  horarios                HorarioMisa[]
  platicas                Platica[]
  sustitucionesProgramado SustitucionMisa[] @relation("SustitucionProgramado")
  sustitucionesReal       SustitucionMisa[] @relation("SustitucionReal")

  @@map("padres")
}

// Un padre celebra en varias iglesias (RF-41, RN-28). Baja lógica: `activo = false` lo desasocia
// sin perder el historial de sus misas.
model PadreIglesia {
  padreId   String
  padre     Padre    @relation(fields: [padreId], references: [id], onDelete: Restrict)
  iglesiaId String
  iglesia   Iglesia  @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([padreId, iglesiaId])
  @@index([iglesiaId, activo])
  @@map("padres_iglesias")
}

// RN-20: diaria, dominical o especial (P-16: una especial también puede ir en el horario)
enum TipoMisa {
  DIARIA
  DOMINICAL
  ESPECIAL
}

// RN-21, supuesto P-19: español y las lenguas indígenas más habladas; «OTRO» para las demás
enum IdiomaMisa {
  ESPANOL
  NAHUATL
  MAYA
  TSELTAL
  TSOTSIL
  MIXTECO
  ZAPOTECO
  OTOMI
  TOTONACO
  MAZATECO
  CHOL
  OTRO
}

// Horario semanal de misas de una iglesia (RF-42, RF-43, RF-46). Lo que normalmente pasa (RN-29).
// La hora es la local de la iglesia (RN-31); el choque de un padre lo valida el service (RN-26,
// misas/dominio/solapes.ts). Baja lógica: las misas celebradas siguen apuntando a su horario.
model HorarioMisa {
  id          String     @id @default(uuid())
  iglesiaId   String
  iglesia     Iglesia    @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  // 0 = domingo … 6 = sábado, como HorarioReunion
  diaSemana   Int
  // «HH:mm» en la hora local de la iglesia
  hora        String
  tipo        TipoMisa
  idioma      IdiomaMisa @default(ESPANOL)
  // Nulo = una hora (RN-27)
  duracionMin Int?
  padreId     String
  padre       Padre      @relation(fields: [padreId], references: [id], onDelete: Restrict)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  celebraciones MisaCelebrada[]

  @@index([iglesiaId, activo, diaSemana])
  @@index([padreId, activo])
  @@map("horarios_misa")
}

// Hecho: un día, una hora y el padre que realmente ofició la misa (RN-29).
// E3-05 agrega campos opcionales para no romper las misas que ya registra el diezmo (E4).
model MisaCelebrada {
  id              String       @id @default(uuid())
  iglesiaId       String
  iglesia         Iglesia      @relation(fields: [iglesiaId], references: [id])
  // Instante de inicio (UTC); la hora local es la de la zona horaria de la iglesia
  inicio          DateTime
  // Padre que la ofició realmente (RN-29); si hubo sustitución, el programado está en SustitucionMisa
  padreId         String
  padre           Padre        @relation("MisaPadreReal", fields: [padreId], references: [id])
  // Misa del horario de la que sale (RF-48). Nulo en una especial de una sola fecha (P-16)
  horarioMisaId   String?
  horarioMisa     HorarioMisa? @relation(fields: [horarioMisaId], references: [id], onDelete: Restrict)
  // Fecha local de la iglesia: una celebración por misa del horario y día (P-17)
  fecha           DateTime?    @db.Date
  // Nulo = una hora (RN-27)
  duracionMin     Int?
  registradoPorId String?
  registradoPor   Usuario?     @relation("MisaRegistrador", fields: [registradoPorId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  diezmo      Diezmo?
  sustitucion SustitucionMisa?

  @@unique([horarioMisaId, fecha])
  @@index([iglesiaId, inicio])
  @@index([padreId, inicio])
  @@map("misas_celebradas")
}

// Sustitución de padre en una misa celebrada (RF-49, RF-50, RN-30). Solo se inserta: un disparador
// de la BD impide editarla o borrarla, como el historial del diezmo (RNF-12).
model SustitucionMisa {
  id                String        @id @default(uuid())
  misaCelebradaId   String        @unique
  misaCelebrada     MisaCelebrada @relation(fields: [misaCelebradaId], references: [id], onDelete: Restrict)
  padreProgramadoId String
  padreProgramado   Padre         @relation("SustitucionProgramado", fields: [padreProgramadoId], references: [id], onDelete: Restrict)
  // Siempre es el padre de la misa celebrada (lo comprueba un disparador)
  padreRealId       String
  padreReal         Padre         @relation("SustitucionReal", fields: [padreRealId], references: [id], onDelete: Restrict)
  motivo            String
  hechaPorId        String
  hechaPor          Usuario       @relation("SustitucionAutor", fields: [hechaPorId], references: [id], onDelete: Restrict)
  hechaEn           DateTime      @default(now())

  @@index([padreProgramadoId])
  @@map("sustituciones_misa")
}

// Diezmo recogido en una misa. Una sola captura por misa (RN-41); se corrige, no se borra.
model Diezmo {
  id             String             @id @default(uuid())
  misaId         String             @unique
  misa           MisaCelebrada      @relation(fields: [misaId], references: [id])
  // Se repite aquí para el alcance por iglesia y los reportes (siempre es la de la misa)
  iglesiaId      String
  iglesia        Iglesia            @relation(fields: [iglesiaId], references: [id])
  monto          Decimal            @db.Decimal(12, 2)
  capturadoPorId String
  capturadoPor   Usuario            @relation("DiezmoCapturador", fields: [capturadoPorId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  correcciones   DiezmoCorreccion[]

  @@index([iglesiaId])
  @@map("diezmos")
}

// Historial de correcciones: solo se inserta (un disparador de la BD impide editar o borrar). RN-43.
model DiezmoCorreccion {
  id            String   @id @default(uuid())
  diezmoId      String
  diezmo        Diezmo   @relation(fields: [diezmoId], references: [id])
  montoAnterior Decimal  @db.Decimal(12, 2)
  montoNuevo    Decimal  @db.Decimal(12, 2)
  hechaPorId    String
  hechaPor      Usuario  @relation("DiezmoCorrector", fields: [hechaPorId], references: [id])
  hechaEn       DateTime @default(now())

  @@index([diezmoId])
  @@map("diezmo_correcciones")
}

// ───────────── Ecclesia · Servicios y pláticas (E3-11, E3-13, Genaro) ─────────────

// RN-22, supuesto P-11: con monto fijo, gratuito o con donativo voluntario (con monto sugerido opcional)
enum FormaCosto {
  MONTO
  GRATUITO
  DONATIVO
}

// Servicio de una iglesia: bautizo, primera comunión, confirmación, casamiento u otro (RF-30).
// Supuesto P-10: la lista es abierta; cada iglesia escribe el nombre. Baja lógica con `activo`.
model Servicio {
  id           String            @id @default(uuid())
  iglesiaId    String
  iglesia      Iglesia           @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  nombre       String
  formaCosto   FormaCosto
  // MONTO: obligatorio y > 0; DONATIVO: sugerido opcional; GRATUITO: nulo (CHECK en la BD)
  monto        Decimal?          @db.Decimal(12, 2)
  requisitos   String?
  // Cuánto dura, en minutos (RF-32)
  duracionMin  Int?
  requiereCita Boolean           @default(false)
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  horarios     HorarioServicio[]

  @@index([iglesiaId, activo])
  @@map("servicios")
}

// Días y horarios fijos en que se celebra un servicio (RF-33; supuesto P-12: cero o más; sin
// horarios y con cita = «con cita»). Se reemplazan completos al editar: se borran (AGENTS §1.3).
model HorarioServicio {
  id         String   @id @default(uuid())
  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  diaSemana  Int
  hora       String

  @@unique([servicioId, diaSemana, hora])
  @@map("horarios_servicio")
}

// RN-24, supuesto P-13: solo los cuatro tipos del caso
enum TipoPlatica {
  PREBAUTISMAL
  PRIMERA_COMUNION
  CONFIRMACION
  PREMATRIMONIAL
}

// Plática de preparación (RF-36): días y hora, sesiones, costo exacto, cupo, lugar y quién la da.
// Supuesto P-13: el cupo es informativo (sin inscripciones). P-14: quién la da es texto libre y,
// si es un padre de la iglesia, se puede enlazar.
model Platica {
  id        String           @id @default(uuid())
  iglesiaId String
  iglesia   Iglesia          @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  tipo      TipoPlatica
  sesiones  Int
  // 0.00 = gratuita (RN-25: misma exactitud que el dinero)
  costo     Decimal          @db.Decimal(12, 2)
  cupo      Int
  lugar     String
  imparte   String
  padreId   String?
  padre     Padre?           @relation(fields: [padreId], references: [id], onDelete: Restrict)
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  horarios  HorarioPlatica[]

  @@index([iglesiaId, activo, tipo])
  @@map("platicas")
}

// Días y hora en que se imparte una plática (RF-36). Se reemplazan completos al editar.
model HorarioPlatica {
  id        String  @id @default(uuid())
  platicaId String
  platica   Platica @relation(fields: [platicaId], references: [id], onDelete: Cascade)
  diaSemana Int
  hora      String

  @@unique([platicaId, diaSemana, hora])
  @@map("horarios_platica")
}

// ───────────── B1 · Configuración de la iglesia ─────────────

// Fila única con id fijo = 1
// E1-06b: YA NO SE USA. Sus datos pasaron a Iglesia (moneda, zona horaria, logo y sitio web).
// La tabla se conserva hasta que el equipo confirme borrarla (no se borran datos sin confirmación).
model ConfiguracionIglesia {
  id          Int      @id @default(1)
  nombre      String
  logoUrl     String?
  direccion   String?
  ciudad      String?
  telefono    String?
  email       String?
  sitioWeb    String?
  moneda      String   @default("MXN")
  zonaHoraria String   @default("America/Mexico_City")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configuracion_iglesia")
}

model HorarioReunion {
  id         String   @id @default(uuid())
  nombre     String
  // 0 = domingo … 6 = sábado
  diaSemana  Int
  // Formato "HH:mm"
  horaInicio String
  horaFin    String?
  lugar      String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // E1-06: iglesia dueña (alcance por iglesia, ADR-0007). RESTRICT: una iglesia con historia no se borra.
  iglesiaId String
  iglesia   Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  @@index([diaSemana, horaInicio])
  @@index([iglesiaId, diaSemana])
  @@map("horarios_reunion")
}

// ───────────── Ecclesia · Patrimonio (E2-08 y E2-10, Nataly) ─────────────

// Objeto patrimonial de una iglesia (RF-13–RF-17). Nunca se borra: cambia de estado (RN-11).
model ObjetoPatrimonial {
  id                 String       @id @default(uuid())
  iglesiaId          String
  descripcion        String
  tipo               TipoObjeto
  // RN-10: año exacto o, si no se conoce, siglo (CHECK objetos_anio_o_siglo en la migración)
  anio               Int?
  siglo              Int?
  material           String
  estadoConservacion String
  ubicacionEnTemplo  String
  catalogadoInah     Boolean      @default(false)
  estado             EstadoObjeto @default(VIGENTE)
  fechaEstado        DateTime?    @db.Date
  motivoEstado       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  iglesia Iglesia @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)

  @@index([iglesiaId, estado])
  @@index([tipo, estado])
  @@map("objetos_patrimoniales")
}

// Criterios del índice (RF-22, RN-14, ADR-0005). Cada cambio es una versión nueva; la más reciente
// es la vigente. Sin filas, el service usa los criterios del caso (CRITERIOS_INICIALES).
model CriteriosIndice {
  id              String   @id @default(uuid())
  rangosEdad      Json
  multiplicadores Json
  puntosInah      Decimal  @db.Decimal(5, 1)
  distinciones    Json
  creadoPorId     String?
  createdAt       DateTime @default(now())

  creadoPor Usuario? @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("criterios_indice")
}

// ───────────── Ecclesia · Criptas y otros espacios (E4-07, Oscar) ─────────────

enum ClaseEspacio {
  CRIPTA
  NICHO
  COLUMBARIO
  OSARIO
}

// Mismos valores que el dominio puro (modules/espacios/dominio/tipos.ts)
enum EstadoSolicitudEspacio {
  RECIBIDA
  SIN_LUGAR
  COTIZADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

enum RespuestaCotizacion {
  ACEPTADA
  RECHAZADA
  VENCIDA
}

// Lo que una iglesia ofrece. No se borra (conserva sus solicitudes): se desactiva. RN-47.
model TipoEspacio {
  id         String       @id @default(uuid())
  iglesiaId  String
  iglesia    Iglesia      @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  clase      ClaseEspacio
  // false = la iglesia dejó de ofrecerlo; disponible = false: ofrecido, pero sin lugar por ahora
  activo     Boolean      @default(true)
  disponible Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  solicitudes SolicitudEspacio[]

  @@unique([iglesiaId, clase])
  @@map("tipos_espacio")
}

// Solicitud hecha sin cuenta: se consulta con folio y clave (RN-49). Los datos de contacto son
// privados de la iglesia (RN-53). La clave solo se guarda como hash.
model SolicitudEspacio {
  id               String                 @id @default(uuid())
  folio            String                 @unique
  claveHash        String
  iglesiaId        String
  iglesia          Iglesia                @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  tipoEspacioId    String
  tipoEspacio      TipoEspacio            @relation(fields: [tipoEspacioId], references: [id], onDelete: Restrict)
  contactoNombre   String
  contactoTelefono String?
  contactoCorreo   String?
  comentarios      String?
  estado           EstadoSolicitudEspacio @default(RECIBIDA)
  // Consultas con clave incorrecta; al llegar al límite se bloquea ese folio un rato (supuestos.ts)
  intentosFallidos Int                    @default(0)
  bloqueadoHasta   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  cotizaciones Cotizacion[]

  @@index([iglesiaId, estado])
  @@index([tipoEspacioId])
  @@map("solicitudes_espacio")
}

// Varias por solicitud, con a lo sumo una sin respuesta (índice parcial en la migración): así, si el
// cliente permite volver a cotizar (P-26), no hace falta otra migración.
model Cotizacion {
  id           String               @id @default(uuid())
  solicitudId  String
  solicitud    SolicitudEspacio     @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  monto        Decimal              @db.Decimal(12, 2)
  condiciones  String
  emitidaEn    DateTime
  venceEn      DateTime
  respuesta    RespuestaCotizacion?
  respondidaEn DateTime?
  createdAt    DateTime             @default(now())

  @@index([solicitudId])
  @@map("cotizaciones")
}
