// Modelo de datos de AppIglesia — fuente: specs.md §6.
// Dueño: B1. Cambios solo vía PR revisado por B1 y el dueño del modelo (AGENTS.md §3).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Rol {
  // Nacional (Ecclesia): sin iglesia asignada
  COORDINACION
  // Antes ADMIN; administrador de una iglesia
  ADMIN_IGLESIA
  PASTOR
  SECRETARIO
  TESORERO
  COORDINADOR
}

enum TipoIglesia {
  CATEDRAL
  BASILICA
  PARROQUIA
  TEMPLO
  CAPILLA
  SANTUARIO
}

enum TipoEvento {
  RELIGIOSO
  ADMINISTRATIVO
}

enum CategoriaEvento {
  CULTO
  REUNION
  ACTIVIDAD
  OTRO
}

enum EstadoEvento {
  PROGRAMADO
  CANCELADO
  REALIZADO
}

enum ConceptoDonacion {
  DIEZMO
  OFRENDA
  PRIMICIA
  DONACION_ESPECIAL
  OTRO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  OTRO
}

enum PrioridadAnuncio {
  NORMAL
  IMPORTANTE
}

// ───────────── B1 · Usuarios y autenticación ─────────────

model Usuario {
  id                 String             @id @default(uuid())
  nombre             String
  email              String             @unique
  // Nulo mientras el usuario no configura su contraseña desde la invitación (B1-14)
  passwordHash       String?
  rol                Rol
  // Iglesia a la que pertenece el personal. Nulo solo para la Coordinación (alcance nacional).
  iglesiaId          String?
  // Restrict: una iglesia con personal no se borra (se cierra con `activa = false`)
  iglesia            Iglesia?           @relation(fields: [iglesiaId], references: [id], onDelete: Restrict)
  diezmosCapturados  Diezmo[]           @relation("DiezmoCapturador")
  correccionesDiezmo DiezmoCorreccion[] @relation("DiezmoCorrector")
  activo             Boolean            @default(true)
  ultimoAcceso       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  refreshTokens          RefreshToken[]
  resetTokens            PasswordResetToken[]
  ministeriosCoordinados MinisterioCoordinador[]
  eventosCreados         Evento[]                @relation("EventoCreador")
  asistenciasRegistradas Asistencia[]            @relation("AsistenciaRegistrador")
  donacionesRegistradas  Donacion[]              @relation("DonacionRegistrador")
  donacionesActualizadas Donacion[]              @relation("DonacionActualizador")
  anuncios               Anuncio[]

  @@index([iglesiaId])
  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  tokenHash  String    @unique
  expiraEn   DateTime
  revocadoEn DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

// ───────────── B2 · Miembros y ministerios ─────────────

model Miembro {
  id              String    @id @default(uuid())
  nombre          String
  apellidos       String
  telefono        String?
  email           String?
  fechaIngreso    DateTime  @db.Date
  fechaNacimiento DateTime? @db.Date
  direccion       String?
  notas           String?
  activo          Boolean   @default(true)
  fechaBaja       DateTime? @db.Date
  motivoBaja      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ministerios   MiembroMinisterio[]
  responsableDe EventoResponsable[]
  asistencias   Asistencia[]
  donaciones    Donacion[]

  @@index([apellidos, nombre])
  @@index([activo])
  @@map("miembros")
}

model Ministerio {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coordinadores MinisterioCoordinador[]
  miembros      MiembroMinisterio[]
  eventos       Evento[]

  @@map("ministerios")
}

model MinisterioCoordinador {
  ministerioId String
  usuarioId    String

  ministerio Ministerio @relation(fields: [ministerioId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@id([ministerioId, usuarioId])
  @@index([usuarioId])
  @@map("ministerio_coordinadores")
}

model MiembroMinisterio {
  miembroId    String
  ministerioId String
  fechaUnion   DateTime  @default(now())
  fechaSalida  DateTime?
  activo       Boolean   @default(true)

  miembro    Miembro    @relation(fields: [miembroId], references: [id])
  ministerio Ministerio @relation(fields: [ministerioId], references: [id])

  @@id([miembroId, ministerioId])
  @@index([ministerioId])
  @@map("miembro_ministerios")
}

// ───────────── B3 · Eventos, asistencia y anuncios ─────────────

model Evento {
  id                String          @id @default(uuid())
  titulo            String
  descripcion       String?
  tipo              TipoEvento
  categoria         CategoriaEvento
  fechaInicio       DateTime
  fechaFin          DateTime?
  lugar             String
  estado            EstadoEvento    @default(PROGRAMADO)
  motivoCancelacion String?
  ministerioId      String?
  creadoPorId       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ministerio   Ministerio?         @relation(fields: [ministerioId], references: [id])
  creadoPor    Usuario             @relation("EventoCreador", fields: [creadoPorId], references: [id])
  responsables EventoResponsable[]
  asistencias  Asistencia[]
  anuncios     Anuncio[]

  @@index([fechaInicio])
  @@index([ministerioId])
  @@map("eventos")
}

model EventoResponsable {
  eventoId  String
  miembroId String

  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  miembro Miembro @relation(fields: [miembroId], references: [id])

  @@id([eventoId, miembroId])
  @@map("evento_responsables")
}

model Asistencia {
  id              String   @id @default(uuid())
  eventoId        String
  miembroId       String
  presente        Boolean
  registradoPorId String
  registradoEn    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evento        Evento  @relation(fields: [eventoId], references: [id])
  miembro       Miembro @relation(fields: [miembroId], references: [id])
  registradoPor Usuario @relation("AsistenciaRegistrador", fields: [registradoPorId], references: [id])

  @@unique([eventoId, miembroId])
  @@index([miembroId])
  @@map("asistencias")
}

model Anuncio {
  id               String           @id @default(uuid())
  titulo           String
  // Texto plano o markdown simple
  contenido        String
  prioridad        PrioridadAnuncio @default(NORMAL)
  fechaPublicacion DateTime
  fechaExpiracion  DateTime?
  eventoId         String?
  autorId          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  evento Evento? @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  autor  Usuario @relation(fields: [autorId], references: [id])

  @@index([fechaPublicacion])
  @@map("anuncios")
}

// ───────────── B4 · Donaciones ─────────────

model Donacion {
  id               String           @id @default(uuid())
  fecha            DateTime         @db.Date
  monto            Decimal          @db.Decimal(12, 2)
  concepto         ConceptoDonacion
  conceptoDetalle  String?
  metodo           MetodoPago
  // Nulo ⇔ donación anónima (specs.md §6, reglas de integridad)
  miembroId        String?
  anonima          Boolean          @default(false)
  referencia       String?
  notas            String?
  anulada          Boolean          @default(false)
  motivoAnulacion  String?
  anuladaEn        DateTime?
  registradoPorId  String
  actualizadoPorId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  miembro        Miembro? @relation(fields: [miembroId], references: [id])
  registradoPor  Usuario  @relation("DonacionRegistrador", fields: [registradoPorId], references: [id])
  actualizadoPor Usuario? @relation("DonacionActualizador", fields: [actualizadoPorId], references: [id])

  @@index([fecha])
  @@index([miembroId])
  @@map("donaciones")
}

// ───────────── Ecclesia · Iglesias ─────────────

// Una fila por iglesia. Reemplaza a la fila única de ConfiguracionIglesia; la ficha completa
// (dirección, INEGI, contacto, patrimonio) la amplía el módulo de iglesias.
model Iglesia {
  id          String      @id @default(uuid())
  nombre      String
  tipo        TipoIglesia
  zonaHoraria String      @default("America/Mexico_City")
  // Una iglesia cerrada conserva su historia pero no aparece en consultas públicas
  activa      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  usuarios Usuario[]
  misas    MisaCelebrada[]
  diezmos  Diezmo[]

  @@map("iglesias")
}

// ───────────── Ecclesia · Misas y diezmo ─────────────

// Padre que oficia misas. Versión mínima que necesita el diezmo; el módulo de misas la amplía
// (asociación a varias iglesias, agenda, horario semanal).
model Padre {
  id        String   @id @default(uuid())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  misas MisaCelebrada[]

  @@map("padres")
}

// Hecho: un día, una hora y el padre que realmente ofició la misa (RN-29). Versión mínima.
model MisaCelebrada {
  id        String   @id @default(uuid())
  iglesiaId String
  iglesia   Iglesia  @relation(fields: [iglesiaId], references: [id])
  // Instante de inicio (UTC); la hora local es la de la zona horaria de la iglesia
  inicio    DateTime
  padreId   String
  padre     Padre    @relation(fields: [padreId], references: [id])
  createdAt DateTime @default(now())

  diezmo Diezmo?

  @@index([iglesiaId, inicio])
  @@map("misas_celebradas")
}

// Diezmo recogido en una misa. Una sola captura por misa (RN-41); se corrige, no se borra.
model Diezmo {
  id             String             @id @default(uuid())
  misaId         String             @unique
  misa           MisaCelebrada      @relation(fields: [misaId], references: [id])
  // Se repite aquí para el alcance por iglesia y los reportes (siempre es la de la misa)
  iglesiaId      String
  iglesia        Iglesia            @relation(fields: [iglesiaId], references: [id])
  monto          Decimal            @db.Decimal(12, 2)
  capturadoPorId String
  capturadoPor   Usuario            @relation("DiezmoCapturador", fields: [capturadoPorId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  correcciones   DiezmoCorreccion[]

  @@index([iglesiaId])
  @@map("diezmos")
}

// Historial de correcciones: solo se inserta (un disparador de la BD impide editar o borrar). RN-43.
model DiezmoCorreccion {
  id            String   @id @default(uuid())
  diezmoId      String
  diezmo        Diezmo   @relation(fields: [diezmoId], references: [id])
  montoAnterior Decimal  @db.Decimal(12, 2)
  montoNuevo    Decimal  @db.Decimal(12, 2)
  hechaPorId    String
  hechaPor      Usuario  @relation("DiezmoCorrector", fields: [hechaPorId], references: [id])
  hechaEn       DateTime @default(now())

  @@index([diezmoId])
  @@map("diezmo_correcciones")
}

// ───────────── B1 · Configuración de la iglesia ─────────────

// Fila única con id fijo = 1
model ConfiguracionIglesia {
  id          Int      @id @default(1)
  nombre      String
  logoUrl     String?
  direccion   String?
  ciudad      String?
  telefono    String?
  email       String?
  sitioWeb    String?
  moneda      String   @default("MXN")
  zonaHoraria String   @default("America/Mexico_City")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configuracion_iglesia")
}

model HorarioReunion {
  id         String   @id @default(uuid())
  nombre     String
  // 0 = domingo … 6 = sábado
  diaSemana  Int
  // Formato "HH:mm"
  horaInicio String
  horaFin    String?
  lugar      String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([diaSemana, horaInicio])
  @@map("horarios_reunion")
}
