          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "// Otro padre de la iglesia para «Registrar con sustitución».",
                  "if (r.data && r.data.length) pm.collectionVariables.set('otroPadreId', r.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear y asociar un padre",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iglesias/{{iglesiaId}}/padres",
              "host": ["{{baseUrl}}"],
              "path": ["iglesias", "{{iglesiaId}}", "padres"]
            },
            "description": "Si ya existe uno con ese nombre → 409 con su id en el detalle; la variable padreId queda con ese id y «Asociar un padre existente» lo asocia.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Canul\",\n  \"titulo\": \"Pbro.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.id) pm.collectionVariables.set('padreId', r.data.id);",
                  "// 409: ya existe un padre con ese nombre; el detalle trae su id (supuesto P-19).",
                  "const existente = r.error && r.error.details && r.error.details[0] && r.error.details[0].mensaje.match(/Padre existente: (\\S+)/);",
                  "if (existente) pm.collectionVariables.set('padreId', existente[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Asociar un padre existente",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
