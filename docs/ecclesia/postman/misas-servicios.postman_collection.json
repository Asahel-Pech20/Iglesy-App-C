            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.data.accessToken);",
                  "if (r.data.iglesia) pm.collectionVariables.set('iglesiaId', r.data.iglesia.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
